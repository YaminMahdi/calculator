<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/calc_background"
    android:fitsSystemWindows="false"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="24dp">

    <!-- Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.6"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_expression"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_result"
            android:textSize="56sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="start" />
    </LinearLayout>

    <!-- Top Utility / Tool Bar (4 circular buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_history"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_tool_bg"
                android:backgroundTint="@null"
                android:src="@drawable/ic_history"
                android:contentDescription="History" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_mode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_tool_bg"
                android:backgroundTint="@null"
                android:src="@drawable/ic_calc_mode"
                android:contentDescription="Mode" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_tool_bg"
                android:backgroundTint="@null"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_backspace"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_tool_bg"
                android:backgroundTint="@null"
                android:src="@drawable/ic_backspace"
                android:contentDescription="Delete" />
        </FrameLayout>
    </LinearLayout>

    <!-- Keypad Grid (Squircle buttons matching demo69.png) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.4"
        android:orientation="vertical">

        <!-- Row 1: C, MC, %, ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button
                android:id="@+id/btn_clear"
                android:text="C"
                android:textColor="@color/btn_operator_text"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_operator_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_mc"
                android:text="MC"
                android:textColor="@color/btn_operator_text"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_operator_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_percent"
                android:text="%"
                android:textColor="@color/btn_operator_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_operator_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_divide"
                android:text="÷"
                android:textColor="@color/btn_operator_text"
                android:textSize="28sp"
                android:background="@drawable/btn_operator_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button
                android:id="@+id/btn_7"
                android:text="7"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_8"
                android:text="8"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_9"
                android:text="9"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_multiply"
                android:text="×"
                android:textColor="@color/btn_operator_text"
                android:textSize="26sp"
                android:background="@drawable/btn_operator_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button
                android:id="@+id/btn_4"
                android:text="4"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_5"
                android:text="5"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_6"
                android:text="6"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_minus"
                android:text="-"
                android:textColor="@color/btn_operator_text"
                android:textSize="28sp"
                android:background="@drawable/btn_operator_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button
                android:id="@+id/btn_1"
                android:text="1"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_2"
                android:text="2"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_3"
                android:text="3"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_plus"
                android:text="+"
                android:textColor="@color/btn_operator_text"
                android:textSize="28sp"
                android:background="@drawable/btn_operator_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 5: 0 (span 2), •, = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <!-- 0 is a wide capsule spanning 2 widths! -->
            <Button
                android:id="@+id/btn_0"
                android:text="0"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_dot"
                android:text="•"
                android:textColor="@color/btn_number_text"
                android:textSize="28sp"
                android:background="@drawable/btn_number_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/btn_equals"
                android:text="="
                android:textColor="@color/btn_equals_text"
                android:textSize="32sp"
                android:background="@drawable/btn_equals_bg"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
